# Clawdmeter daemon config
#
# Copy this file to:
#   macOS / Linux : ~/.config/claude-usage-monitor/config
#   Windows       : %LOCALAPPDATA%\Clawdmeter\config
#
# The daemon re-reads it on every poll, so edits take effect within ~60s — no restart needed.

# Poll more than one Claude config dir and show whichever plan is currently
# active. Use this if you run separate plans from different config dirs (e.g. a
# personal plan in ~/.claude and a work plan in ~/.claude-work, selected via
# CLAUDE_CONFIG_DIR). Comma-separated; ~ is expanded.
#   - The daemon polls every listed dir each cycle and displays the plan whose
#     usage rose most recently (i.e. the one you're actively using). Before any
#     change is seen it shows the plan with the highest current usage.
#   - Unset (default) = just ~/.claude, unchanged single-plan behavior.
#   - install.sh can detect your ~/.claude* dirs and fill this in for you.
# config_dirs = ~/.claude, ~/.claude-work

# Seconds between Anthropic API polls (Linux daemon). Default 60. Minimum 10.
# The firmware marks data older than 90s as stale and only updates its "resets
# in" countdown when a payload lands, so anything above ~80 relies on the
# heartbeat below to keep the display live.
# poll_interval = 60

# Seconds between heartbeat replays of the last payload while waiting for the
# next API poll (Linux daemon). The replay ages the reset countdowns and clock
# so the display stays accurate without an API call. Default 60. Minimum 10.
# Set it >= poll_interval to disable.
# heartbeat_interval = 60

# Play a sound on the device when your 5-hour session limit resets, so you know
# you can use Claude again without watching the screen.
#   off = silent (default)
#   on  = chime through the board speaker (boards with audio: S3 AMOLED-2.16 / 1.8, LCD-1.54)
chime = off

# Beep when a Claude Code session needs your attention (needs the hooks from the
# README). The mascot walks on and the message shows either way; this only adds
# the sound.
#   off = silent (default)
#   on  = chime through the board speaker (boards with audio: S3 AMOLED-2.16 / 1.8, LCD-1.54)
beep = off
# Show a clock on the Usage screen, in place of the "Usage" title.
#   off  = no clock; the screen keeps showing "Usage" (default)
#   auto = show the clock, auto-detecting 12h/24h from this machine's settings
#          (detection can default to 24h when the daemon runs under launchd/systemd
#           with no locale — set 12 or 24 explicitly below if auto guesses wrong)
#   12   = show the clock, forced 12-hour  (e.g. 6:28 PM)
#   24   = show the clock, forced 24-hour  (e.g. 18:28)
clock = off

# Pace screen (Linux daemon): the current 5-hour window as a sparkline, where
# you'll land at reset at your current pace ("Limit by 15:40"), and the last 7
# days of weekly usage. The daemon keeps its own record of every poll in
# ~/.config/claude-usage-monitor/usage-history.jsonl (8 days), so the week fills
# in as it runs. Pro/Max accounts only. On by default.
# pace = off

# Activity screen (Linux daemon): your live Claude Code sessions (working /
# waiting on you / idle) and today's tokens with their API-equivalent cost,
# read from the transcripts in each config dir's projects/ folder. Nothing
# leaves this machine except the summary sent to the device. On by default.
# activity = off

# Service status (Linux daemon): checks status.claude.com every 5 minutes; while
# there's an incident the device's status line shows it with an amber/red dot.
# On by default.
# service_status = off

# System screen (Linux daemon): this machine's CPU, memory, CPU temperature and
# disk, every 30 seconds. Off by default.
# system_stats = on

# Weather screen (Linux daemon). A place name, looked up with Open-Meteo's
# geocoder (no account, no key); refreshed every 15 minutes. Includes wind
# (km/h), UV index, air quality (European AQI) and a rain-in-the-next-hour
# nowcast on the status line. If the lookup picks the wrong place, pin it with
# weather_coords = <lat>, <lon>.
# Unset (default) = no weather screen.
# weather_location = Ennetmoos
# weather_coords = 46.956, 8.339

# Stocks screen (Linux daemon). Up to 5 Yahoo Finance symbols, comma-separated;
# SYMBOL=Label overrides the name shown under the ticker. Refreshed every 5
# minutes. Unset (default) = no stocks screen.
# stocks = AMD, NVDA=NVIDIA, PLTR=Palantir, R3NK.DE=Renk
